# Copy to dev.tfvars (git-ignored) and edit. No secrets belong in this file.
environment = "dev"
aws_region  = "eu-west-1" # choose your own

# Cost-lean demo profile: worker on Fargate Spot scaling from zero, db.t4g.micro single AZ, 7-day logs.
# Same security posture as the normal profile. Tear the environment down when you are done (docs/aws/teardown.md).
demo = true

# Budget alerts (50% and 80% of actual spend, 100% of forecast). Empty email = no budget.
budget_limit_usd = 50
budget_email     = "REPLACE_WITH_YOUR_EMAIL"

single_nat_gateway     = true
db_deletion_protection = false
db_skip_final_snapshot = true # demo data is disposable; set false to keep a final snapshot
api_min_count          = 1
api_max_count          = 2
worker_max_count       = 2
qdrant_instance_type   = "t3.small"
qdrant_volume_gb       = 20

# From the Qdrant image mirror step in docs/aws/deployment.md:
# qdrant_image_digest = "sha256:..."
# acm_certificate_arn = ""   # empty => HTTP only (dev only)
# github_repository   = "owner/name"
