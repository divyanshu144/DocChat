# Copy to prod.tfvars (git-ignored) and edit. No secrets belong in this file.
environment               = "prod"
aws_region                = "eu-west-1" # choose your own
acm_certificate_arn       = "REPLACE_WITH_YOUR_ACM_CERTIFICATE_ARN"
single_nat_gateway        = false
db_instance_class         = "db.t4g.medium"
db_multi_az               = true
db_backup_retention_days  = 14
db_deletion_protection    = true
db_skip_final_snapshot    = false
api_min_count             = 2
api_max_count             = 6
worker_min_count          = 1
worker_max_count          = 6
qdrant_instance_type      = "t3.large"
qdrant_volume_gb          = 100
log_retention_days        = 90
alarm_email               = "REPLACE_WITH_ONCALL_EMAIL"
# github_repository       = "owner/name"
