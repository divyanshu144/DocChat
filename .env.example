LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=openai
GROQ_API_KEY=your_groq_api_key_here
# Groq decommissioned llama-3.3-70b-versatile; check GET /models before changing this.
CHAT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_CHAT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=docchat-agent
# Set false to silence tracing without removing the key (eval/benchmark runs)
LANGSMITH_TRACING=true
# Leave blank for US keys. EU-region keys 403 against the US host — set:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Qdrant/PostgreSQL — use these values when running with docker-compose
QDRANT_HOST=qdrant
QDRANT_PORT=6333
DATABASE_URL=postgresql+asyncpg://docchat:docchat@postgres:5432/docchat

# Blank = disabled. Set to collect critic-rejected drafts for fine-tuning data.
CRITIC_REJECTION_LOG=

# Optional
DEBUG=false
UPLOAD_MAX_BYTES=52428800
INGEST_BATCH_SIZE=64
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
CHAT_RATE_LIMIT=30

# Optional; blank preserves the selected OpenAI model's default reasoning
OPENAI_REASONING_EFFORT=

# Optional self-hosted vLLM endpoint (no GPU required when another provider is selected)
LOCAL_BASE_URL=
LOCAL_CHAT_MODEL=
LOCAL_API_KEY=
# Buffer local backend streams internally to measure model TTFT; UI remains verified/buffered.
LOCAL_STREAM_COMPLETIONS=false
INFERENCE_CONNECT_TIMEOUT_S=5
INFERENCE_READ_TIMEOUT_S=60
INFERENCE_POOL_TIMEOUT_S=5
INFERENCE_MAX_CONNECTIONS=100

# Optional metrics protection; blank requires a private scrape network.
METRICS_BEARER_TOKEN=
