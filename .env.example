LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=openai
GROQ_API_KEY=your_groq_api_key_here
# Groq decommissioned llama-3.3-70b-versatile; check GET /models before changing this.
CHAT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_CHAT_MODEL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=docchat-agent
# Set false to silence tracing without removing the key (eval/benchmark runs)
LANGSMITH_TRACING=true
# Leave blank for US keys. EU-region keys 403 against the US host — set:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Qdrant/PostgreSQL — use these values when running with docker-compose
QDRANT_HOST=qdrant
QDRANT_PORT=6333
DATABASE_URL=postgresql+asyncpg://docchat:docchat@postgres:5432/docchat

# Blank = disabled. Set to collect critic-rejected drafts for fine-tuning data.
CRITIC_REJECTION_LOG=

# Optional
DEBUG=false
UPLOAD_MAX_BYTES=52428800
INGEST_BATCH_SIZE=64
